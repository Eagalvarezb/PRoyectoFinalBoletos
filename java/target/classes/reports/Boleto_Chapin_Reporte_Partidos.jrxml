			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<query language="SQL"><![CDATA[SELECT 
    p.id_partido,
    p.equipo_local || ' vs ' || p.equipo_visitante AS encuentro,
    p.equipo_local,
    p.equipo_visitante,
    p.fecha_partido,
    p.estadio,
    COALESCE(SUM(dv.cantidad * dv.precio_unitario), 0) AS total_ventas,
    CASE
        WHEN p.fecha_partido = CURRENT_DATE THEN 'activo'
        WHEN p.fecha_partido > CURRENT_DATE THEN 'programado'
        ELSE 'finalizado'
    END AS estado_actual
FROM partidos p
LEFT JOIN detalle_ventas dv ON dv.id_partido = p.id_partido
LEFT JOIN ventas v ON dv.id_venta = v.id_venta
GROUP BY p.id_partido, p.equipo_local, p.equipo_visitante, p.fecha_partido, p.estadio
ORDER BY p.fecha_partido DESC;
]]></query>
