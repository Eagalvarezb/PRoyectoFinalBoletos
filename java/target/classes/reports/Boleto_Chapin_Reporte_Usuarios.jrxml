	<query language="SQL"><![CDATA[SELECT 
    u.id_usuario,
    u.nombre_completo AS vendedor,
    v.id_venta,
    v.fecha_venta,
    SUM(d.cantidad * d.precio_unitario) AS subtotal_venta,
    SUM(SUM(d.cantidad * d.precio_unitario)) OVER (PARTITION BY u.id_usuario) AS total_vendedor
FROM usuarios u
JOIN ventas v ON u.id_usuario = v.id_vendedor
JOIN detalle_ventas d ON v.id_venta = d.id_venta
GROUP BY u.id_usuario, u.nombre_completo, v.id_venta, v.fecha_venta
ORDER BY u.nombre_completo, v.fecha_venta;
]]></query>
