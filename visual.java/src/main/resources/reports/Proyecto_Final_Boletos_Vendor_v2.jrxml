	<query language="SQL"><![CDATA[SELECT 
    u.id_usuario,
    u.nombre_completo AS vendedor,
    v.id_venta,
    v.fecha_venta,
    SUM(d.cantidad * d.precio_unitario) AS subtotal_venta,
    (
        SELECT SUM(dd.cantidad * dd.precio_unitario)
        FROM ventas vv
        JOIN detalle_ventas dd ON vv.id_venta = dd.id_venta
        WHERE vv.id_vendedor = u.id_usuario
    ) AS total_vendedor
FROM usuarios u
JOIN ventas v ON u.id_usuario = v.id_vendedor
JOIN detalle_ventas d ON v.id_venta = d.id_venta
GROUP BY 
    u.id_usuario, 
    u.nombre_completo,
    v.id_venta,
    v.fecha_venta
ORDER BY 
    u.nombre_completo, 
    v.fecha_venta;
]]></query>
